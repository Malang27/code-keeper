## GitLab Configuration File
## Generated by Ansible

## GitLab URL
external_url '{{ gitlab_external_url }}'

## GitLab Email Settings
gitlab_rails['gitlab_email_enabled'] = true
gitlab_rails['gitlab_email_from'] = 'gitlab@{{ ansible_host }}'
gitlab_rails['gitlab_email_display_name'] = 'GitLab'

## Disable auto-migrations during reconfigure
gitlab_rails['auto_migrate'] = true

## GitLab Shell
gitlab_rails['gitlab_shell_ssh_port'] = 22

## Git data directories
git_data_dirs({
  "default" => {
    "path" => "/var/opt/gitlab/git-data"
   }
})

## Backup settings
gitlab_rails['manage_backup_path'] = true
gitlab_rails['backup_path'] = "/var/opt/gitlab/backups"
gitlab_rails['backup_keep_time'] = 604800  # 7 days

## LDAP Settings (disabled by default)
gitlab_rails['ldap_enabled'] = false

## CI/CD Settings
gitlab_ci['gitlab_ci_all_broken_builds'] = true
gitlab_ci['gitlab_ci_add_pusher'] = true

## Container Registry (disabled by default)
registry['enable'] = false

## Monitoring
prometheus['enable'] = true
prometheus['monitor_kubernetes'] = false

## Unicorn (deprecated in favor of Puma)
puma['enable'] = true
puma['worker_timeout'] = 60
puma['worker_processes'] = 2

## PostgreSQL
postgresql['enable'] = true
postgresql['shared_buffers'] = "256MB"

## Redis
redis['enable'] = true

## Nginx
nginx['enable'] = true
nginx['listen_port'] = 80
nginx['listen_https'] = false

## Logging
logging['logrotate_frequency'] = "daily"
logging['logrotate_rotate'] = 30

## Package repository
gitlab_rails['packages_enabled'] = true

## Container Registry
registry_external_url 'http://{{ ansible_host }}:5050'

## Gitaly
gitaly['enable'] = true

## Let's Encrypt (disabled by default, enable if you have a domain)
letsencrypt['enable'] = false

## Timezone
gitlab_rails['time_zone'] = 'UTC'
